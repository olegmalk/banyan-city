argv: ["C:\\banyan-farm\\venv\\Scripts\\python.exe", "-c", "# THE GLOB CARRIES THE BEAT SLUG (07-confiscate). Without it the glob\n# matches nothing and the step publishes nothing while returning a code\n# that reads like a render failure -- that is what made six rendered\n# plates read as six failures on 2026-08-14. No allow_fail: a publish\n# that cannot find its files is a FAIL of the job, not a footnote.\nimport glob, hashlib, os, shutil\nout_dir = \"C:/banyan-farm/ep2-b07-point-motion-0819-out\"\npay_dir = \"C:/banyan-farm/ep2-b07-point-motion-0819\"\ndst = \"C:/banyan-farm/courier-box/farm-out/ep2-b07-point-motion-0819\"\nos.makedirs(dst, exist_ok=True)\nfiles = sorted(glob.glob(out_dir + \"/07-confiscate-LTX-twofig-r1s3.mp4*\")\n               + glob.glob(out_dir + \"/b07-twofig-init-704x1280.png\")\n               + glob.glob(out_dir + \"/bench-b07-twofig.jsonl\")\n               + glob.glob(pay_dir + \"/b07-motion-prompt.txt\")\n               + glob.glob(pay_dir + \"/b07-negative.txt\"))\nlines = []\nfor f in files:\n    shutil.copy2(f, dst)\n    c = os.path.join(dst, os.path.basename(f))\n    with open(c, \"rb\") as fh:\n        h = hashlib.sha256(fh.read()).hexdigest()\n    lines.append(h + \"  \" + os.path.basename(f))\nwith open(os.path.join(dst, \"ep2-b07-point-motion-0819.sha256\"), \"w\", newline=\"\\n\") as fh:\n    fh.write(\"\\n\".join(sorted(lines)) + \"\\n\")\nprint(\"published\", len(files), \"file(s) + manifest ->\", dst)\nraise SystemExit(0 if len(files) >= 6 else 1)"]
