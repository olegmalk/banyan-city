argv: ["C:\\banyan-farm\\venv\\Scripts\\python.exe", "-c", "# THE GLOB CARRIES THE BEAT SLUG (02-the-sprint). Without it the glob matches\n# nothing and the step publishes nothing while returning a code that reads\n# like a render failure.\nimport glob, hashlib, os, shutil\nout_dir = \"C:/banyan-farm/ep2-b02-anchor-0816-out\"\npay_dir = \"C:/banyan-farm/ep2-b02-anchor-0816\"\ndst = \"C:/banyan-farm/courier-box/farm-out/ep2-b02-anchor-0816\"\nos.makedirs(dst, exist_ok=True)\nsrc = sorted(glob.glob(out_dir + \"/02-the-sprint-LTX-anchor.mp4*\")\n             + glob.glob(out_dir + \"/b02-init-704x1280.png\")\n             + glob.glob(out_dir + \"/bench-anchor.jsonl\")\n             + glob.glob(pay_dir + \"/b02-motion-prompt.txt\")\n             + glob.glob(pay_dir + \"/b02-negative.txt\"))\nlines = []\nfor f in src:\n    shutil.copy2(f, dst)\n    c = os.path.join(dst, os.path.basename(f))\n    with open(c, \"rb\") as fh:\n        h = hashlib.sha256(fh.read()).hexdigest()\n    lines.append(h + \"  \" + os.path.basename(f))\nwith open(os.path.join(dst, \"ep2-b02-anchor-0816.sha256\"), \"w\", newline=\"\\n\") as fh:\n    fh.write(\"\\n\".join(sorted(lines)) + \"\\n\")\nprint(\"published\", len(src), \"file(s) + manifest ->\", dst)\nraise SystemExit(0 if len(src) >= 3 else 1)\n"]
