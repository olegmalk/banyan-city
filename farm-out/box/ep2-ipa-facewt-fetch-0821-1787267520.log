argv: ["C:\\banyan-farm\\venv\\Scripts\\python.exe", "-c", "# Fetches, ASSERTS THE DIGESTS (not the byte counts -- the two adapters\n# are the same length), and writes its manifest straight into\n# courier-box\\farm-out, because the courier pushes from there and\n# nowhere else.\nimport glob, hashlib, json, os, sys\nfrom huggingface_hub import snapshot_download\nREPO = \"h94/IP-Adapter\"\nFACE = \"sdxl_models/ip-adapter-plus-face_sdxl_vit-h.safetensors\"\nPLUS = \"sdxl_models/ip-adapter-plus_sdxl_vit-h.safetensors\"\nSIZE = 847517512\nWANT = {FACE: \"677ad8860204f7d0bfba12d29e6c31ded9beefdf3e4bbd102518357d31a292c1\",\n        PLUS: \"3f5062b8400c94b7159665b21ba5c62acdcd7682262743d7f2aefedef00e6581\"}\n\ndef sha(p):\n    h = hashlib.sha256()\n    with open(p, \"rb\") as fh:\n        for c in iter(lambda: fh.read(1 << 20), b\"\"):\n            h.update(c)\n    return h.hexdigest()\n\n# THREE patterns, not one. See the header: a face-only pull can strand\n# the incumbent recipe in a stale snapshot dir. Unchanged files are\n# already in the content-addressed blob store and cost no network.\nd = snapshot_download(REPO, allow_patterns=[FACE, PLUS,\n                                            \"models/image_encoder/*\"])\nprint(\"snapshot:\", d, flush=True)\nbad, man = [], []\nfor rel, want in sorted(WANT.items()):\n    p = os.path.join(d, rel.replace(\"/\", os.sep))\n    if not os.path.exists(p):\n        bad.append(\"MISSING \" + rel)\n        continue\n    n = os.path.getsize(p)\n    got = sha(p)\n    print(\"  %-52s %13d bytes  %s\" % (os.path.basename(rel), n, got),\n          flush=True)\n    if n != SIZE:\n        bad.append(\"SIZE %s: %d != %d\" % (rel, n, SIZE))\n    if got != want:\n        bad.append(\"SHA %s: %s != %s\" % (rel, got, want))\n    man.append(\"%s  %s  %d\" % (got, rel, n))\n\n# THE ENCODER, because ip_adapter_image_encoder_folder points at it and\n# a missing encoder is a hard offline miss inside the render.\nenc = os.path.join(d, \"models\", \"image_encoder\")\nencf = sorted(os.path.basename(f) for f in glob.glob(enc + os.sep + \"*\"))\nprint(\"  image_encoder:\", encf, flush=True)\nif \"config.json\" not in encf:\n    bad.append(\"image_encoder/config.json missing\")\nif not any(f.endswith((\".safetensors\", \".bin\")) for f in encf):\n    bad.append(\"image_encoder has no weight file\")\nelse:\n    cfgp = os.path.join(enc, \"config.json\")\n    with open(cfgp, \"r\", encoding=\"utf-8\") as fh:\n        c = json.load(fh)\n    print(\"  encoder image_size:\", c.get(\"image_size\"),\n          \"patch_size:\", c.get(\"patch_size\"),\n          \"hidden_size:\", c.get(\"hidden_size\"), flush=True)\n    if c.get(\"image_size\") != 224:\n        bad.append(\"encoder image_size is %r, not 224\" % c.get(\"image_size\"))\n\ninc = glob.glob(os.path.join(\n    os.environ.get(\"HF_HOME\", \"\"), \"hub\", \"models--h94--IP-Adapter\",\n    \"**\", \"*.incomplete\"), recursive=True)\nprint(\"  .incomplete files:\", len(inc), flush=True)\nif inc:\n    bad.append(\"%d .incomplete file(s) under the cache\" % len(inc))\n\ndst = r\"C:\\banyan-farm\\courier-box\\farm-out\\ep2-ipa-facewt-fetch-0821\"\nos.makedirs(dst, exist_ok=True)\nwith open(os.path.join(dst, \"ep2-ipa-facewt-fetch-0821.manifest.txt\"),\n          \"w\", encoding=\"utf-8\", newline=\"\\n\") as fh:\n    fh.write(\"repo: %s\\nsnapshot: %s\\nencoder: %s\\n\\n%s\\n\"\n             % (REPO, d, \",\".join(encf), \"\\n\".join(sorted(man))))\nprint(\"published manifest ->\", dst, flush=True)\n\nfor b in bad:\n    print(\"!! \" + b, file=sys.stderr)\nraise SystemExit(1 if bad else 0)"]

