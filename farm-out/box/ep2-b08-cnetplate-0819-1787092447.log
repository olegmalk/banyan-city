argv: ["C:\\banyan-farm\\venv\\Scripts\\python.exe", "-c", "# THE STEP THIS JOB EXISTS TO NOT REPEAT. ep2-cnet-probe-0817 rendered\n# all four of its arms on 2026-08-17 and was invisible for two days\n# because it had no step like this one: it declared artifacts under its\n# own working directory and nothing ever carried them to farm-out, which\n# is the only path by which a box result reaches the repo. box_enqueue\n# now REFUSES a spec without one (courier_problems, 2026-08-19), and\n# this job is the first filed through that guard.\n#\n# THE GLOBS NAME THE FILES EXACTLY. A glob that matches nothing publishes\n# nothing while exiting 0, which is what made six rendered plates read as\n# six failures on 2026-08-14. No allow_fail, and the count is asserted.\nimport glob, hashlib, os, shutil\nout_dir = \"C:/banyan-farm/b08cnetplate-0819/out\"\nsrc_dir = \"C:/banyan-farm/b08cnetplate-0819/src\"\npay_dir = \"C:/banyan-farm/b08cnetplate-0819\"\ndst = \"C:/banyan-farm/courier-box/farm-out/ep2-b08-cnetplate-0819\"\nos.makedirs(dst, exist_ok=True)\nfiles = sorted(glob.glob(out_dir + \"/ep2-b08-cnetplate-0819-hint.png*\")\n               + glob.glob(out_dir + \"/ep2-b08-cnetplate-0819-nocontrol.png*\")\n               + glob.glob(src_dir + \"/pipeline/control/b08-pose-0819.png\")\n               + glob.glob(pay_dir + \"/prompt.txt\")\n               + glob.glob(pay_dir + \"/negative.txt\"))\nlines = []\nfor f in files:\n    shutil.copy2(f, dst)\n    c = os.path.join(dst, os.path.basename(f))\n    with open(c, \"rb\") as fh:\n        h = hashlib.sha256(fh.read()).hexdigest()\n    lines.append(h + \"  \" + os.path.basename(f))\nwith open(os.path.join(dst, \"ep2-b08-cnetplate-0819.sha256\"), \"w\",\n          newline=\"\\n\") as fh:\n    fh.write(\"\\n\".join(sorted(lines)) + \"\\n\")\nprint(\"published\", len(files), \"file(s) + manifest ->\", dst)\nraise SystemExit(0 if len(files) >= 7 else 1)"]
