argv: ["C:\\banyan-farm\\venv\\Scripts\\python.exe", "-c", "# Stamp EVERY sidecar in the out dir as an unapproved provisional take.\n# goblin_ipa_sample.py writes model, prompt, negative, seed, cost_usd 0.00 and\n# `scored: false` at render time, and it does NOT write whether the still may\n# ship. REFUSES if it found no sidecar -- a run whose provenance files did not\n# get written must not pass silently.\nimport glob, os\nout_dir = \"C:/banyan-farm/goblin-ipa-0812/out-b02-platescale-0817\"\nside = sorted(glob.glob(out_dir + \"/*.yaml\"))\nif not side:\n    raise SystemExit(\"!! no sidecar yaml in %s -- refusing to call the job clean.\" % out_dir)\nfor p in side:\n    with open(p, \"a\", encoding=\"utf-8\", newline=\"\\n\") as fh:\n        fh.write(\n            \"# --- appended after the render by the sapling-canon anchor lane, 2026-08-17.\\n\"\n            \"approved: false\\n\"\n            \"provisional: true\\n\"\n            \"cost_usd_confirmed: 0\\n\"\n            \"note: |\\n\"\n            \"  ONE SAMPLE of ONE re-cut draft key (authored_b02_plate_scale_0816). Not a pick,\\n\"\n            \"  not a seed confirmation, not approved for any cut. A lane reads the\\n\"\n            \"  sixteen frames against THIS BEAT's bar before anything built on it is\\n\"\n            \"  filed. Taste and trunk/graft calls are R4's and this run makes none.\\n\")\nprint(\"stamped\", len(side), \"sidecar(s) in\", out_dir)\n"]
