argv: ["C:\\banyan-farm\\venv\\Scripts\\python.exe", "-c", "# Required by box_enqueue.courier_problems: a job whose artifacts live\n# outside courier-box\\farm-out must have a step that carries them there,\n# because the courier pushes from farm-out and from nowhere else.\n# ep2-cnet-probe-0817 rendered perfectly and was invisible for two days\n# for want of exactly this.\nimport glob, hashlib, os, shutil\nout_dir = \"C:/banyan-farm/b08ipa-0819/out\"\npay_dir = \"C:/banyan-farm/b08ipa-0819\"\nref_dir = \"C:/banyan-farm/b08ipa-0819/src/pipeline/control\"\ndst = \"C:/banyan-farm/courier-box/farm-out/ep2-b08-ipamask-0819\"\nos.makedirs(dst, exist_ok=True)\n# The two references travel WITH the frame. They are the frame's\n# conditioning, so a reader scoring identity needs them beside it, and\n# their sha lines in the manifest are what prove the bytes that\n# conditioned this render are the bytes in the repo.\nfiles = sorted(glob.glob(out_dir + \"/ep2-b08-ipamask-0819-ipamask.png*\")\n               + glob.glob(pay_dir + \"/prompt.txt\")\n               + glob.glob(pay_dir + \"/negative.txt\")\n               + glob.glob(ref_dir + \"/b08-ref-*-0819.png\"))\nlines = []\nfor f in files:\n    shutil.copy2(f, dst)\n    c = os.path.join(dst, os.path.basename(f))\n    with open(c, \"rb\") as fh:\n        h = hashlib.sha256(fh.read()).hexdigest()\n    lines.append(h + \"  \" + os.path.basename(f))\nwith open(os.path.join(dst, \"ep2-b08-ipamask-0819.sha256\"), \"w\",\n          newline=\"\\n\") as fh:\n    fh.write(\"\\n\".join(sorted(lines)) + \"\\n\")\nprint(\"published\", len(files), \"file(s) + manifest ->\", dst)\nraise SystemExit(0 if len(files) >= 6 else 1)"]
