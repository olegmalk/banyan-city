{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip3 install --break-system-packages pyyaml markdown",
  "buildCommand": "python3 pipeline/build_site.py",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/fork",
      "destination": "/create",
      "permanent": false
    },
    {
      "source": "/contribute",
      "destination": "/create",
      "permanent": false
    }
  ],
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "*": false,
      "farm-results-*": false,
      "farm-results-**": false,
      "runpod-results": false,
      "main": true
    }
  },
  "ignoreCommand": "bash pipeline/vercel-ignore-build.sh",
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/(review|status|pulse)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    }
  ]
}
