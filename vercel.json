{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip3 install --break-system-packages pyyaml markdown",
  "buildCommand": "python3 pipeline/build_site.py",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "*": false,
      "farm-results-*": false,
      "farm-results-**": false,
      "runpod-results": false,
      "main": true
    }
  },
  "ignoreCommand": "bash pipeline/vercel-ignore-build.sh",
  "github": {
    "silent": true
  }
}
